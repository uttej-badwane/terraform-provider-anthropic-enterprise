# The release workflow installs semantic-release into the working tree. An
# untracked directory there makes goreleaser refuse to build, which is a
# safeguard worth keeping, so the directory is ignored rather than the check
# relaxed.
node_modules/
.vagrant/
*.backup
*.tfstate
*.tfvars
*.tfvars.json
.terraform/
*.log
*.bak
*~
.*.swp
.idea
*.iml
